{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PMC Trainer — npx serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "-p", "3000", "--no-clipboard"],
      "port": 3000
    },
    {
      "name": "PMC Trainer — Python http.server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "--directory", "."],
      "port": 8080
    }
  ]
}
